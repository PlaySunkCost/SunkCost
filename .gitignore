# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data for ignored folders
!/[Aa]ssets/**/*.meta

# Unity's crash-recovery copies of unsaved scenes: local only, never the source
/[Aa]ssets/_Recovery*

# IDE
.vs/
.idea/
.vscode/
.claude-flow/
.claude/settings.local.json
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS
.DS_Store
Thumbs.db
desktop.ini

# Builds
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Addressables / packed content
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Ss]erver[Bb]uild/

# Local secrets — never commit Steam keys or build credentials
steam_appid.txt
*.env
*.slnx

# Raw generator downloads (Meshy and the like): huge, and reproducible from the
# concept pictures in docs/reference. The processed model beside them is committed.
# They live in Generated~, which Unity does not import (2.1 GB of it once did);
# tools/blender/prepare_ship_part.py reads them from there.
Assets/_Project/Models/**/Generated~/
Assets/_Project/Models/**/Generated/
Assets/_Project/Models/**/Generated.meta

# Blender FBX export side-copies of textures; the Maps/ folder is the source
Assets/_Project/Models/**/*.fbm/
Assets/_Project/Models/**/*.fbm.meta
